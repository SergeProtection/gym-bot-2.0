# Copy to .env and fill in. Never commit .env.

# From @BotFather
TELEGRAM_BOT_TOKEN=

# PostgreSQL in production (Railway sets this when you add a Postgres database).
# Leave empty locally to use a SQLite file (gymbot.db).
DATABASE_URL=

# Public https address of this service, for the Mini App button.
# On Railway this is filled in automatically from RAILWAY_PUBLIC_DOMAIN.
WEBAPP_URL=

PORT=8000
DEFAULT_REST_SECONDS=90
LOG_LEVEL=INFO

# Local development only: open http://localhost:8000/app/ in a browser
# without Telegram, acting as this Telegram user id. Never set in production.
# DEV_USER_ID=
